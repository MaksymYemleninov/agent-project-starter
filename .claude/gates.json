{
  "$comment": "Tuning for the documentation gates. /onboard rewrites sourcePaths and manifests for the chosen stack; the defaults below only cover common JavaScript layouts and are wrong for most other languages.",
  "stage": "building",
  "$stage": "exploration = gates report and never block, for a project still finding its shape. building = gates hold, the normal working state. production = building, reserved for stricter freshness later. /onboard sets exploration on a new project; /harden moves it to building. This key is required: without it the gates fall back to building silently, and a silent default is how it went missing in the first place.",
  "sourcePaths": [
    "src/**",
    "app/**",
    "lib/**",
    "server/**",
    "packages/**",
    "api/**",
    "components/**"
  ],
  "manifests": [
    "package.json",
    "requirements.txt",
    "pyproject.toml",
    "go.mod",
    "Cargo.toml",
    "Gemfile",
    "composer.json"
  ],
  "infra": {
    "$comment": "Infrastructure as code. `paths` is what counts as infrastructure: it feeds the Stop hook's spec and log nudges, and is the write scope of the infra-engineer agent. `foundations` is the subset that fixes the shape of the infrastructure (state backend, root configuration, one environment or account); changing one of those is a decision and the ADR gate asks for a record. Editing a module is not. /onboard deletes nothing here when there is no infrastructure: globs that match nothing gate nothing. `lightBootstrapMaxComponents`: a bootstrap whose plan has at most this many distinct components and at most two environments runs light (no separate plan review, one engineer pass, one code review cycle). Above it, the full pipeline.",
    "paths": [
      "infra/**",
      "**/*.tf",
      "**/*.tfvars",
      "**/*.hcl"
    ],
    "foundations": [
      "**/backend.tf",
      "**/backend.hcl",
      "**/root.hcl",
      "**/root.terragrunt.hcl",
      "**/env.hcl",
      "**/account.hcl",
      "**/region.hcl"
    ],
    "lightBootstrapMaxComponents": 5
  },
  "guardrails": [
    "scripts/lint-docs.mjs",
    "scripts/check-adr-drift.mjs",
    "scripts/changed-files.mjs",
    "scripts/commands.mjs",
    "scripts/repair.mjs",
    "scripts/test-gates.mjs",
    ".github/workflows/**",
    ".claude/settings.json",
    ".claude/gates.json",
    ".claude/hooks/**",
    ".claude/agents/**",
    ".claude/claude-security-guidance.md"
  ],
  "stopHook": {
    "sourceFilesWithoutSpec": 3,
    "requireLogEntry": true,
    "requireAdrForGuardrails": true
  },
  "secretPaths": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.keystore",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/*credentials*.json",
    "**/service-account*.json",
    "**/secrets.*",
    "**/*.tfstate",
    "**/*.tfstate.*",
    "**/*.tfplan"
  ],
  "secretPathAllowlist": [
    "**/.env.example",
    "**/.env.sample",
    "**/.env.template",
    "**/.env.defaults"
  ],
  "agentScopes": {
    "$comment": "What each subagent may write and run, enforced by .claude/hooks/agent-scope.mjs from the agent's own frontmatter. `write` is globs, `@infra` expands to infra.paths; `create` globs admit a new file only, never an edit. `bash` is command prefixes; a leading `cd <dir> &&` and VAR=value assignments are allowed, anything else chained is refused. `pipes: true` lets read-only agents pipe, as long as every segment is itself allowed. Quoting is understood; redirection other than to /dev/null is refused. A profile missing here means the agent is refused everything, on purpose.",
    "code-reviewer": {
      "write": [],
      "pipes": true,
      "bash": [
        "git diff",
        "git log",
        "git show",
        "git status",
        "git blame",
        "npm test",
        "npm run test",
        "npm run lint:docs",
        "npm run check:adr",
        "npm run test:gates",
        "ls",
        "rg",
        "grep",
        "head",
        "tail",
        "wc",
        "cat",
        "npx tsc --noEmit",
        "npx depcruise",
        "go vet",
        "mypy",
        "pyright",
        "lint-imports"
      ]
    },
    "researcher": {
      "write": [],
      "pipes": true,
      "bash": [
        "git log",
        "git show",
        "git diff",
        "ls",
        "rg",
        "grep",
        "head",
        "tail",
        "wc",
        "cat"
      ]
    },
    "test-writer": {
      "write": [
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/*_test.*",
        "**/test_*.py",
        "**/conftest.py"
      ],
      "pipes": true,
      "bash": [
        "npm test",
        "npm run test",
        "node --test",
        "npx vitest",
        "npx jest",
        "pytest",
        "python -m pytest",
        "go test",
        "cargo test",
        "git diff",
        "git status",
        "ls",
        "rg",
        "grep",
        "head",
        "tail"
      ]
    },
    "infra-architect": {
      "write": [
        "docs/specs/*/plan.md"
      ],
      "create": [
        "docs/decisions/0*-*.md"
      ],
      "pipes": true,
      "bash": [
        "gh api",
        "gh release view",
        "curl -s https://registry.terraform.io/",
        "curl -s https://registry.opentofu.org/",
        "curl -fsSL https://registry.terraform.io/",
        "curl -s https://api.github.com/",
        "helm show chart",
        "helm show values",
        "jq",
        "ls",
        "rg",
        "grep",
        "head",
        "tail",
        "cat"
      ]
    },
    "infra-engineer": {
      "write": [
        "@infra",
        "docs/specs/*/tasks.md",
        ".mise.toml",
        ".tool-versions",
        ".terraform-version"
      ],
      "pipes": false,
      "bash": [
        "terraform init",
        "terraform validate",
        "terraform plan",
        "terraform fmt",
        "terraform output",
        "terraform show",
        "terraform providers",
        "terraform version",
        "terraform -version",
        "terraform state list",
        "terraform state show",
        "terraform graph",
        "tofu init",
        "tofu validate",
        "tofu plan",
        "tofu fmt",
        "tofu output",
        "tofu show",
        "tofu providers",
        "tofu version",
        "tofu -version",
        "tofu state list",
        "tofu state show",
        "tofu graph",
        "terragrunt init",
        "terragrunt validate",
        "terragrunt plan",
        "terragrunt output",
        "terragrunt hcl fmt",
        "terragrunt hclfmt",
        "terragrunt hcl validate",
        "terragrunt render",
        "terragrunt run --all validate",
        "terragrunt run --all plan",
        "terragrunt run-all validate",
        "terragrunt run-all plan",
        "terragrunt state list",
        "terragrunt state show",
        "terragrunt --version",
        "tflint",
        "mise install",
        "mise trust",
        "mise current",
        "mise ls",
        "aws sts get-caller-identity",
        "mkdir -p",
        "ls",
        "git status",
        "git diff"
      ]
    },
    "infra-reviewer": {
      "write": [
        "docs/specs/*/review.md"
      ],
      "pipes": false,
      "bash": [
        "terraform fmt -check",
        "terraform fmt -recursive -check",
        "terraform init",
        "terraform validate",
        "terraform plan",
        "terraform version",
        "tofu fmt -check",
        "tofu fmt -recursive -check",
        "tofu init",
        "tofu validate",
        "tofu plan",
        "tofu version",
        "terragrunt hcl fmt --check",
        "terragrunt hclfmt --check",
        "terragrunt validate",
        "terragrunt plan",
        "terragrunt run --all validate",
        "terragrunt run --all plan",
        "terragrunt run-all validate",
        "terragrunt run-all plan",
        "terragrunt --version",
        "tflint",
        "checkov -d",
        "trivy config",
        "aws sts get-caller-identity",
        "git diff",
        "git status",
        "ls",
        "rg",
        "grep"
      ]
    },
    "security-reviewer": {
      "write": [],
      "pipes": true,
      "bash": [
        "git diff",
        "git log",
        "git show",
        "git status",
        "git blame",
        "ls",
        "rg",
        "grep",
        "head",
        "tail",
        "wc",
        "cat",
        "gitleaks git",
        "gitleaks dir",
        "osv-scanner scan",
        "semgrep scan",
        "npm audit",
        "pnpm audit",
        "pip-audit",
        "govulncheck",
        "trivy fs",
        "trivy config",
        "checkov -d"
      ]
    }
  },
  "$markers": "Fixes that must not quietly come back. Each marker is a string that has to stay in `file` for as long as the fix exists; lint-docs fails when it disappears. Add one whenever you fix a bug that an agent could plausibly 'simplify' away, with `why` written for someone who does not know the history. Removing one is a guardrail change and needs an ADR.",
  "markers": [
    {
      "id": "stop-hook-sees-commits",
      "file": "scripts/changed-files.mjs",
      "marker": "git(`diff --name-only ${mergeBase} HEAD`)",
      "why": "The Stop hook and the ADR gate once looked only at the working tree, so an agent that committed and then stopped walked straight past both."
    },
    {
      "id": "untracked-dirs-expanded",
      "file": "scripts/changed-files.mjs",
      "marker": "--untracked-files=all",
      "why": "Without it a new untracked directory is reported as its name only, and file globs such as **/backend.tf never see the files inside it."
    },
    {
      "id": "stop-hook-no-loop",
      "file": ".claude/hooks/stop-check.mjs",
      "marker": "payload.stop_hook_active",
      "why": "A Stop hook that blocks the stop it caused loops forever, and a hook that loops gets deleted."
    },
    {
      "id": "crlf-normalised",
      "file": "scripts/lint-docs.mjs",
      "marker": ".replace(/\\r\\n/g, '\\n')",
      "why": "A Windows checkout with autocrlf made every frontmatter block unparseable and every document report as malformed."
    },
    {
      "id": "apply-guard-wired",
      "file": ".claude/hooks/pre-bash.mjs",
      "marker": "irreversibleInfra(command)",
      "why": "The only check that stops an agent running terraform apply behind cd, a subshell or a wrapper, which permission prefixes miss."
    },
    {
      "id": "gate-tests-force-building",
      "file": "scripts/test-gates.mjs",
      "marker": "stage: 'building'",
      "why": "The suite once inherited the host project stage; at exploration every blocking assertion failed in the first real derived project."
    },
    {
      "id": "repair-guards-tests",
      "file": "scripts/repair.mjs",
      "marker": "hash(f) !== hashes[f]",
      "why": "The repair loop's only defence against an agent making a test pass by editing the test. Without it the loop cheats and reports success."
    }
  ]
}
