# Code CI, deliberately inactive.
#
# GitHub only runs files ending in .yml or .yaml, so this one does nothing until you rename it:
#
#     git mv .github/workflows/code.yml.example .github/workflows/code.yml
#
# Do that when there is code worth checking, which is when the first spec is implemented and a
# real test command exists. Before that this job spends twenty seconds per push printing that it
# has nothing to do, and a check that always passes vacuously is indistinguishable from a check
# that is broken.
#
# Reasoning: the inherited tooling ADR in a derived project
#
# If the stack is not Node, replace the steps rather than adapting them. This file is a starting
# point, not a contract.

name: Code

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  code:
    name: Build, lint and test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install
        run: npm ci

      # The mechanical floor from .claude/skills/engineering-rulebook/SKILL.md section 2.
      # No --if-present here: a missing floor script must fail the job, not skip the step.
      - name: Format
        run: npm run format:check

      - name: Lint
        run: npm run lint

      - name: Type check
        run: npm run typecheck

      - name: Boundaries
        run: npm run check:boundaries

      - name: Build
        run: npm run build --if-present

      - name: Test
        run: npm test

# Python, replacing the job's steps (see engineering-rulebook/python.md):
#   - uses: astral-sh/setup-uv@RESOLVE-ME
#   - run: uv sync --locked
#   - run: uv run ruff format --check .
#   - run: uv run ruff check .
#   - run: uv run mypy src
#   - run: uv run lint-imports
#   - run: uv run pytest
#
# Go, replacing the job's steps (see engineering-rulebook/go.md):
#   - uses: actions/setup-go@RESOLVE-ME
#     with: { go-version-file: go.mod }
#   - run: test -z "$(gofmt -l .)"
#   - uses: golangci/golangci-lint-action@RESOLVE-ME
#   - run: go vet ./...
#   - run: go run golang.org/x/vuln/cmd/govulncheck@latest ./...   # pin instead of @latest
#   - run: go test -race ./...
