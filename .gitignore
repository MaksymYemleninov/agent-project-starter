# Generic only. /onboard phase 6 adds the chosen stack's entries; without them an untracked
# virtual environment or build directory is copied into the gate test sandbox on every run.

node_modules/
dist/
build/
coverage/
.env
.env.*
!.env.example
*.log
.DS_Store
.claude/.state/
.claude/settings.local.json

# Infrastructure state and plans hold secrets in plain text. Ignored from day zero rather than at
# onboarding: the cost of forgetting is a leaked credential, not a noisy diff.
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
